// Skema Database Prisma untuk Dashboard Weed Control GGP
// Berdasarkan dokumen panduan: doc/prompt_skema_database_weed_control_ggp.md

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Model Mastersheet: Menyimpan satu baris untuk setiap lokasi unik
model Mastersheet {
  lokasi         String    @id @db.VarChar(50)
  status         String?   @db.VarChar(50)
  wilayah        String?   @db.VarChar(50)
  luas           Decimal?  @db.Decimal(12, 2)
  jenis          String?   @db.VarChar(50)
  kelas          String?   @db.VarChar(50)
  mulaiRawat     DateTime? @map("mulai_rawat") @db.Date
  mulaiTanam     DateTime? @map("mulai_tanam") @db.Date
  forcingStandar DateTime? @map("forcing_standar") @db.Date
  realForcing    DateTime? @map("real_forcing") @db.Date
  selesaiPanen   DateTime? @map("selesai_panen") @db.Date
  umurForcing    Int?      @map("umur_forcing")
  umur           Int?
  totalCost      Decimal?  @map("total_cost") @db.Decimal(18, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relasi ke tabel anak (1:N)
  costUmurList   CostUmur[]
  timelineList   DataTimeline[]
  aktivitasList  DataAktivitas[]

  @@index([wilayah, status])
  @@map("mastersheet")
}

// 2. Model CostUmur: Transformasi wide-to-long dari kolom Umur 1 sampai Umur 20 pada Data Lokasi
model CostUmur {
  id        BigInt   @id @default(autoincrement())
  lokasi    String   @db.VarChar(50)
  umur      Int
  cost      Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  mastersheet Mastersheet @relation(fields: [lokasi], references: [lokasi], onDelete: Restrict, onUpdate: Cascade)

  @@unique([lokasi, umur])
  @@index([umur])
  @@map("cost_umur")
}

// 3. Model DataTimeline: Menyimpan setiap transaksi aktivitas per lokasi dari Data Timeline Excel
model DataTimeline {
  id               BigInt    @id @default(autoincrement())
  lokasi           String    @db.VarChar(50)
  awalRawat        DateTime? @map("awal_rawat") @db.Date
  aktivitas        String?   @db.VarChar(255)
  tanggalRealisasi DateTime? @map("tanggal_realisasi") @db.Date
  umur             Int? // Nilai negatif seperti -6 diperbolehkan
  hasil            Decimal?  @db.Decimal(18, 4)
  uom              String?   @db.VarChar(30)
  tk               Decimal?  @db.Decimal(18, 4)
  kapasitasPerTk   Decimal?  @map("kapasitas_per_tk") @db.Decimal(18, 4)
  totalCost        Decimal?  @map("total_cost") @db.Decimal(18, 2)
  upah             Decimal?  @db.Decimal(18, 2)
  charge           Decimal?  @db.Decimal(18, 2)
  material         Decimal?  @db.Decimal(18, 2) // Total biaya material
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  mastersheet  Mastersheet    @relation(fields: [lokasi], references: [lokasi], onDelete: Restrict, onUpdate: Cascade)
  materialList DataMaterial[]

  @@index([lokasi])
  @@index([tanggalRealisasi])
  @@index([aktivitas])
  @@index([umur])
  @@map("data_timeline")
}

// 4. Model DataMaterial: Menyimpan rincian kuantitas material dinamis dari kolom-kolom material Excel
model DataMaterial {
  id           BigInt   @id @default(autoincrement())
  timelineId   BigInt   @map("timeline_id")
  namaMaterial String   @map("nama_material") @db.VarChar(100)
  quantity     Decimal  @db.Decimal(18, 4) // Kuantitas material
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  timeline DataTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([timelineId, namaMaterial])
  @@index([namaMaterial])
  @@map("data_material")
}

// 5. Model DataAktivitas: Menyimpan data transaksi aktivitas dengan denormalisasi kolom status, wilayah, luas, kelas
model DataAktivitas {
  id            BigInt   @id @default(autoincrement())
  lokasi        String   @db.VarChar(50)
  status        String?  @db.VarChar(50)
  wilayah       String?  @db.VarChar(50)
  luas          Decimal? @db.Decimal(12, 2)
  kelas         String?  @db.VarChar(50)
  kode          String?  @db.VarChar(50)
  aktivitas     String?  @db.VarChar(255)
  biaya         Decimal? @db.Decimal(18, 2)
  biayaPerHa    Decimal? @map("biaya_per_ha") @db.Decimal(18, 2)
  upah          Decimal? @db.Decimal(18, 2)
  charge        Decimal? @db.Decimal(18, 2)
  material      Decimal? @db.Decimal(18, 2)
  bibit         Decimal? @db.Decimal(18, 2)
  hasil         Decimal? @db.Decimal(18, 4)
  uom           String?  @db.VarChar(30)
  activityGroup String?  @map("activity_group") @db.VarChar(50) // Bukan "group" karena reserved SQL keyword
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  mastersheet Mastersheet @relation(fields: [lokasi], references: [lokasi], onDelete: Restrict, onUpdate: Cascade)

  @@index([lokasi])
  @@index([wilayah, status])
  @@index([activityGroup, kode])
  @@map("data_aktivitas")
}

