// This is your Prisma schema file for Dashboard WIP (Cost Control)
// Stores ONLY business data for WIP Cost Control platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterSheet {
  lokasi        String      @id @map("lokasi")
  wilayah       String      @map("wilayah")
  luas          Float       @map("luas")
  kodeBibit     String      @map("kode_bibit")
  jenisBibit    String      @map("jenis_bibit")
  kelasBibit    String      @map("kelas_bibit")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  lokasiDetails Lokasi[]
  aktivitasList Aktivitas[]
  akumBahanList AkumBahan[]

  @@map("mastersheet")
}

model Sbt {
  kodeSbt       String      @id @map("kode_sbt")
  nilaiSbt      Float       @map("nilai_sbt")
  status        String?     @map("status")
  pupuk         String?     @map("pupuk")
  jenis         String?     @map("jenis")
  kelas         String?     @map("kelas")
  groupCost     String?     @map("group_cost")
  umur          Int?        @map("umur")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  lokasiDetails Lokasi[]

  @@map("sbt")
}

model Lokasi {
  idLokasi            Int         @id @default(autoincrement()) @map("id_lokasi")
  lokasi              String      @map("lokasi")
  status              String      @default("") @map("status")
  kodeSbt             String      @map("kode_sbt")
  umur                Int         @map("umur")
  groupCost           String      @map("group_cost")
  keteranganGroupCost String?     @map("keterangan_group_cost")
  cost                Float       @map("cost")
  pupuk               String?     @map("pupuk")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  masterSheet MasterSheet @relation(fields: [lokasi], references: [lokasi], onDelete: Cascade)
  sbt         Sbt         @relation(fields: [kodeSbt], references: [kodeSbt], onDelete: Cascade)

  @@map("lokasi")
}

model Aktivitas {
  idAktivitas         Int         @id @default(autoincrement()) @map("id_aktivitas")
  lokasi              String      @map("lokasi")
  kode                String?     @map("kode")
  aktivitas           String      @map("aktivitas")
  groupCost           String      @map("group_cost")
  keteranganGroupCost String?     @map("keterangan_group_cost")
  biaya               Float       @map("biaya")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  masterSheet MasterSheet @relation(fields: [lokasi], references: [lokasi], onDelete: Cascade)

  @@index([lokasi, kode, groupCost])
  @@map("aktivitas")
}

model HistoryAktivitas {
  rowLabels        String      @id @map("row_labels")
  tanggalRealisasi Int         @map("tanggal_realisasi")
  lokasi           String      @map("lokasi")
  kodeAktifitas    String      @map("kode_aktifitas")
  deskripsi        String      @map("deskripsi")
  actCostGroup     String      @map("act_cost_group")
  satuanHasil      String?     @map("satuan_hasil")
  costCharge       Float       @default(0) @map("cost_charge")
  hasilCharge      Float       @default(0) @map("hasil_charge")
  costMaterial     Float       @default(0) @map("cost_material")
  hasilMaterial    Float       @default(0) @map("hasil_material")
  costUpah         Float       @default(0) @map("cost_upah")
  hasilUpah        Float       @default(0) @map("hasil_upah")
  costTotal        Float       @default(0) @map("cost_total")
  hasilTotal       Float       @default(0) @map("hasil_total")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([lokasi, kodeAktifitas, actCostGroup])
  @@index([lokasi])
  @@map("history_aktivitas")
}

model Kelengkapan {
  id             Int         @id @default(autoincrement()) @map("id")
  rowLabels      String      @map("row_labels")
  group          String      @default("") @map("group")
  kodeBahan      String      @map("kode_bahan")
  deskripsiBahan String?     @map("deskripsi_bahan")
  satuanHasil    String?     @map("satuan_hasil")
  sumHasil       Float       @default(0) @map("sum_hasil")
  sumResource    Float       @default(0) @map("sum_resource")
  sumBiaya       Float       @default(0) @map("sum_biaya")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([rowLabels])
  @@map("kelengkapan")
}

model AkumBahan {
  id                Int         @id @default(autoincrement()) @map("id")
  lokasi            String      @map("lokasi")
  kodeMaterial      String      @map("kode_material")
  deskripsiMaterial String      @map("deskripsi_material")
  quantity          Float       @default(0) @map("quantity")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  masterSheet MasterSheet @relation(fields: [lokasi], references: [lokasi], onDelete: Cascade)

  @@index([lokasi])
  @@map("akum_bahan")
}
