generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // SUPER_ADMIN, ADMIN
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dashboardAccess UserDashboardAccess[]
  sessions        AdminSession[]
  activityLogs    AdminActivityLog[]

  @@map("admin_users")
}

model Dashboard {
  id        String   @id @default(uuid())
  code      String   @unique // "wip", "dashboard_a", "dashboard_b", "dashboard_c"
  name      String
  adminUrl  String   @map("admin_url")
  publicUrl String   @map("public_url")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  userAccess UserDashboardAccess[]

  @@map("dashboards")
}

model UserDashboardAccess {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  dashboardId String   @map("dashboard_id")
  grantedAt   DateTime @default(now()) @map("granted_at")

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboardId])
  @@map("user_dashboard_access")
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model AdminActivityLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  action        String
  dashboardCode String?  @map("dashboard_code")
  description   String?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_activity_logs")
}
