{
  "name": "dashboard-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:wip": "npm run dev --workspace=apps/dashboard-wip",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:portal": "npm run dev --workspace=apps/portal"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  }
}
