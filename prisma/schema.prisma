// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  role         String        @default("admin")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]

  @@map("users")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  dataSource  String?
  fileName    String?
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model MasterSheet {
  lokasi        String      @id @map("lokasi")
  wilayah       String      @map("wilayah")
  luas          Float       @map("luas")
  kodeBibit     String      @map("kode_bibit")
  jenisBibit    String      @map("jenis_bibit")
  kelasBibit    String      @map("kelas_bibit")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  lokasiDetails Lokasi[]
  aktivitasList Aktivitas[]

  @@map("mastersheet")
}

model Sbt {
  kodeSbt       String      @id @map("kode_sbt")
  nilaiSbt      Float       @map("nilai_sbt")
  status        String?     @map("status")
  pupuk         String?     @map("pupuk")
  jenis         String?     @map("jenis")
  kelas         String?     @map("kelas")
  groupCost     String?     @map("group_cost")
  umur          Int?        @map("umur")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  lokasiDetails Lokasi[]

  @@map("sbt")
}

model Lokasi {
  idLokasi            Int         @id @default(autoincrement()) @map("id_lokasi")
  lokasi              String      @map("lokasi")
  status              String      @default("") @map("status")
  kodeSbt             String      @map("kode_sbt")
  umur                Int         @map("umur")
  groupCost           String      @map("group_cost")
  keteranganGroupCost String?     @map("keterangan_group_cost")
  cost                Float       @map("cost")
  pupuk               String?     @map("pupuk")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  masterSheet MasterSheet @relation(fields: [lokasi], references: [lokasi], onDelete: Cascade)
  sbt         Sbt         @relation(fields: [kodeSbt], references: [kodeSbt], onDelete: Cascade)

  @@map("lokasi")
}

model Aktivitas {
  idAktivitas         Int         @id @default(autoincrement()) @map("id_aktivitas")
  lokasi              String      @map("lokasi")
  aktivitas           String      @map("aktivitas")
  groupCost           String      @map("group_cost")
  keteranganGroupCost String?     @map("keterangan_group_cost")
  biaya               Float       @map("biaya")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  masterSheet MasterSheet @relation(fields: [lokasi], references: [lokasi], onDelete: Cascade)

  @@map("aktivitas")
}
